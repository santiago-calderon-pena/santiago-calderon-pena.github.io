---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import HorizontalShopItem from "../components/HorizontalShopItem.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("publications")).sort();

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Santiago Calderón-Peña</div>
    <div class="text-2xl py-3 font-semibold text-base-content/80">
      ML Engineer and Researcher
    </div>
    <div class="py-2">
      <div class="text-lg leading-relaxed">
        <p>
          Machine learning engineer and researcher specializing in <strong>Computer Vision, Generative AI, and Explainable AI</strong>. I design and deploy ML systems that combine research rigor with production reality. 4+ years building models and systems that work at scale across vision, language, and multimodal domains. Fluent in English (C2), French (B2), Spanish (Native), with working knowledge of German and Italian.
        </p>
      </div>
    </div>
    <div class="mt-8">
      <a href="/cv" class="btn btn-primary mr-3">View Full CV</a>
      <a href="mailto:santiagocalderon1999@gmail.com" class="btn btn-outline">Get in touch</a>
    </div>
  </div>

  <div class="mt-12">
    <div class="text-3xl w-full font-bold mb-5">Featured Work</div>
  </div>

  <HorizontalCard
    title="IncX"
    img="/penguin.gif"
    desc="A Python library for tracking and visualizing real-time explanations of video content. Built as my MSc thesis research, it interprets how object detection models make decisions frame-by-frame using YOLOv10 with incremental explainability methods."
    url="https://github.com/santiago-calderon-pena/IncX?tab=readme-ov-file#incx"
    badge="Thesis (92/100)"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="IncX Web Application"
    img="https://raw.githubusercontent.com/SantiagoCalderon1999/IncX_WebApplication/refs/heads/main/blob/web_app_2.PNG"
    desc="Interactive web application for real-time video object detection and explanation visualization. Demonstrates how to bring research-grade explainability methods to production, enabling stakeholders to understand AI decisions as they happen."
    url="https://github.com/santiago-calderon-pena/IncX_WebApplication?tab=readme-ov-file"
  />

  <div class="mt-12">
    <div class="text-3xl w-full font-bold mb-5">Latest Research</div>
  </div>

  {
    last_posts.length > 0 ? (
      last_posts.map((item) => (
        <>
          <HorizontalShopItem
            title={item.data.title}
            img={item.data.heroImage}
            desc={item.data.description}
            authors={item.data.authors}
            oldPricing={item.data.oldPricing}
            checkoutUrl={item.data.checkoutUrl}
            badge={item.data.badge}
            url={"/publications/" + item.slug}
            custom_link={item.data.custom_link}
            custom_link_label={item.data.custom_link_label}
          />
          <div class="divider my-0" />
        </>
      ))
    ) : (
      <p class="text-base-content/60">Research papers coming soon.</p>
    )
  }
</BaseLayout>
